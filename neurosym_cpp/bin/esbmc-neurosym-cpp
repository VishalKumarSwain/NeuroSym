#!/bin/bash
# NeuroSym backend for ESBMC, using the experimental C++ bit-blast/MiniSat
# solver (neurosym_cpp/bitblast_solver) instead of the Python pipeline for
# the sat/unsat decision. bitblast_solver now parses SMT-LIB2 natively (see
# neurosym_cpp/smt2_parser.inc), so neurosym-cpp-solve is pure shell -- no
# Python anywhere in this path anymore (dump_ir.py's JSON-IR dump step has
# been removed). Its local model output does not cover every composite-
# expression op the trace builder can ask for (e.g. sign_extend/zero_extend
# nodes), so --neurosym-model-prog "z3 -in" is kept as the fallback local
# interactive solver ESBMC uses to fill in the counterexample whenever the
# fast local parse cannot -- same mechanism the neurosym backend documents
# for any solver whose batch output does not fully cover the model (see
# --help: "z3 -in" example under --neurosym-model-prog).
set -euo pipefail

# Both esbmc and neurosym-cpp-solve are resolved without hardcoding one
# machine's home directory: neurosym-cpp-solve is a sibling of this script
# (same bin/ directory) regardless of where the repo is checked out; esbmc
# is taken from PATH first (the common case once installed), falling back
# to a couple of conventional checkout locations if it isn't.
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
NEUROSYM_PROG="$SCRIPT_DIR/neurosym-cpp-solve"

if command -v esbmc >/dev/null 2>&1; then
    ESBMC=esbmc
elif [ -x "$HOME/VishResearch/esbmc" ]; then
    ESBMC="$HOME/VishResearch/esbmc"
elif [ -x "$HOME/bin/esbmc" ]; then
    ESBMC="$HOME/bin/esbmc"
else
    echo "esbmc-neurosym-cpp: esbmc not found on PATH or in \$HOME/VishResearch or \$HOME/bin -- adjust this script or add esbmc to your PATH" >&2
    exit 1
fi

exec "$ESBMC" --neurosym \
    --neurosym-prog "$NEUROSYM_PROG %f" \
    --neurosym-model-prog "z3 -in" \
    "$@"
