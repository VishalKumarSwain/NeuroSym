#!/bin/bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
if [ "$#" -ne 1 ]; then echo "usage: neurosym-cpp-solve <formula.smt2>" >&2; exit 1; fi
if out="$("$SCRIPT_DIR/../bitblast_solver" "$1" --esbmc-model --smtlib)"; then
 printf '%s\n' "$out"
else
 echo unknown
fi
