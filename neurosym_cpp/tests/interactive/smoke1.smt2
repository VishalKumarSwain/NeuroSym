(set-logic QF_BV)
(declare-const x (_ BitVec 8))
(declare-const y (_ BitVec 8))
(assert (bvult x #x10))
(check-sat)
(push 1)
(assert (= x #x20))
(check-sat)
(pop 1)
(check-sat)
(push 1)
(assert (= (bvadd x y) #x00))
(assert (= x #x05))
(check-sat)
(get-value (x y (bvadd x y)))
(pop 1)
(get-value (x))
(declare-const b Bool)
(assert (=> b (= x #x01)))
(check-sat-assuming (b))
(get-value (x b))
(check-sat-assuming (b (not b)))
(check-sat)
(get-model)
(exit)
